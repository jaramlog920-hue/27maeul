        "choices": [
          {
            "label": "장날 저녁은 늦게 먹자고 한다",
            "reply": [
              {
                "speaker": "postman",
                "text": "늦은 저녁이요. 그럼 그날은 제가 빵을 사 갈게요."
              }
            ]
          },
          {
            "label": "늦는 날은 마중 갈게",
            "reply": [
              {
                "speaker": "postman",
                "text": "마중이요? …그럼 마지막 집은 서두르지 않고 갈게요. 기다리는 사람이 있으니까요."
              }
            ]
          }
        ]
