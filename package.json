{
  "name": "twenty-seven",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/verify-pieces.mjs && node scripts/verify-journey.mjs && node scripts/verify-letters.mjs && node scripts/verify-god-records.mjs && node scripts/verify-connections.mjs && node scripts/verify-chapter-guides.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-pieces.mjs && node scripts/verify-journey.mjs && node scripts/verify-letters.mjs && node scripts/verify-god-records.mjs && node scripts/verify-connections.mjs && node scripts/verify-chapter-guides.mjs",
    "ref": "node scripts/dump-ref.mjs",
    "build:bible": "node scripts/build-bible-subset.mjs",
    "build:pieces": "node scripts/build-pieces.mjs && node scripts/audit-table.mjs",
    "build:journey": "node scripts/build-journey.mjs",
    "build:letters": "node scripts/build-letters.mjs",
    "build:god-records": "node scripts/build-god-records.mjs",
    "build:connections": "node scripts/build-connections.mjs",
    "build:chapter-guides": "node scripts/build-chapter-guides.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
